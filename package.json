{
  "name": "giscus.app",
  "version": "0.0.0",
  "private": false,
  "browserslist": [
    ">0.3%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "cscript": "tsc client.ts --outDir public",
    "cthemes": "postcss styles/themes/*.css --dir public/themes --config styles/themes",
    "mscript": "google-closure-compiler < public/client.js --js_output_file public/client.js",
    "dev": "yarn cscript --watch --preserveWatchOutput & yarn cthemes --watch & next dev",
    "build": "yarn cscript && yarn cthemes && yarn mscript && next build",
    "start": "next start",
    "lint": "stylelint styles/**/*.css && eslint . --cache --max-warnings 0",
    "lint:fix": "stylelint --fix styles/**/*.css && eslint --fix . --cache --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@next/bundle-analyzer": "^12.3.4",
    "@primer/octicons-react": "^19.33.0",
    "@valkey/valkey-glide": "^2.5.1",
    "dompurify": "^3.4.13",
    "jsonwebtoken": "^9.0.3",
    "lit-html": "^3.3.3",
    "mathjax": "4.1.3",
    "next": "^12.3.4",
    "next-plugin-preact": "^3.0.7",
    "next-translate": "^3.2.0",
    "next-translate-plugin": "^3.2.0",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "react-ssr-prepass": "npm:preact-ssr-prepass",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.5",
    "eslint": "^10.8.1",
    "eslint-config-next": "^12.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "google-closure-compiler": "^20260809.0.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-vanilla-rtl": "^0.4.0",
    "typescript": "^5.7.2"
  }
}
